import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import r2_score
from scipy.optimize import curve_fit
from pathlib import Path

# Add parent directories to path for imports
script_dir = Path(__file__).resolve().parent
data_dir = script_dir

# data loading
df = pd.read_csv(data_dir /'time_series___24163005_without_Outliers.csv', sep=";")
Q = df['diso__ref']
h = df['ddho__ref']

valid_mask = (Q > 0) & (h > 0)
Q_valid = Q[valid_mask]
h_valid = h[valid_mask]


# Segment 1
mask1 = (h_valid >= 100) & (h_valid < 300)
h1 = h_valid[mask1]
Q1 = Q_valid[mask1]

# Segment 2
mask2 = (h_valid >= 449)
h2 = h_valid[mask2]
Q2 = Q_valid[mask2]

# Segment 3
mask3 = (h_valid >= 300) & (h_valid < 449)
h3 = h_valid[mask3]
Q3 = Q_valid[mask3]
# First part:
def find_best_shifted_power(h_data, Q_data):
    best_r2 = -np.inf
    best_params = None
    best_c = None

    # c from 1.55 to 1.60
    c_range = np.arange(1.55, 1.61, 0.01)

    for c in c_range:
        #  Q = a * (h-b)^c  => Q^(1/c) = a^(1/c) * (h-b)
        Y = Q_data ** (1 / c)
        X = h_data

        slope, intercept = np.polyfit(X, Y, 1)
        if slope <= 0: continue

        a_est = slope ** c
        b_est = -intercept / slope

        # 简单检查有效性
        if np.any(h_data <= b_est):
            current_r2 = -np.inf
        else:
            Q_pred = a_est * ((h_data - b_est) ** c)
            current_r2 = r2_score(Q_data, Q_pred)

        if current_r2 > best_r2:
            best_r2 = current_r2
            best_params = (a_est, b_est)
            best_c = c

    return best_params, best_c, best_r2


# fitting 1
params1, c1, r2_1 = find_best_shifted_power(h1, Q1)
a1, b1_seg1 = params1


# fitting 2 with sigmoid formation
# 模型: Q = L / (1 + e^(-a*(h-b)))
def sigmoid(h, L, a, b):

    val = -a * (h - b)
    val = np.clip(val, -100, 100)
    return L / (1 + np.exp(val))


# initial guessing
L_guess = Q2.max() * 10  #
a_guess = 0.02  #
b_guess = np.mean(h2)

try:
    #  curve_fit nonlinear fitting
    popt, pcov = curve_fit(sigmoid, h2, Q2, p0=[L_guess, a_guess, b_guess], maxfev=10000)
    L_opt, a_opt, b_opt = popt

    popt_3, pcov_3 = curve_fit(sigmoid, h3, Q3, p0=[L_guess, a_guess, b_guess], maxfev=10000)
    L_opt_3, a_opt_3, b_opt_3 = popt_3

    # computing R2
    Q2_pred = sigmoid(h2, *popt)
    r2_2 = r2_score(Q2, Q2_pred)
    fit_success = True

    Q3_pred = sigmoid(h3, *popt_3)
    r2_3 = r2_score(Q3, Q3_pred)
    fit_success_3 = True
except Exception as e:
    print("Sigmoid fit failed:", e)
    fit_success = False

# print results
print("=" * 50)
print("final results showing")
print("-" * 50)

print(f"the first part (100 <= h < 430) [exponential function]:")
print(f"  equation: Q = {a1:.5e} * (h - {b1_seg1:.4f})^{c1:.2f}")
print(f"  R2: {r2_1:.4f}")
print("-" * 50)

if fit_success:
    print(f"the second part (300 <= h < 449) [Sigmoid]:")
    print(f"  equation: Q = {L_opt_3:.4f} / (1 + e^(-{a_opt_3:.5f} * (h - {b_opt_3:.4f})))")
    print(f"  a : {a_opt_3:.5f}")
    print(f"  b : {b_opt_3:.4f}")
    print(f"  L :   {L_opt_3:.4f}")
    print(f"  R2: {r2_3:.4f}")

    print(f"the third part (h >= 430) [Sigmoid]:")
    print(f"  equation: Q = {L_opt:.4f} / (1 + e^(-{a_opt:.5f} * (h - {b_opt:.4f})))")
    print(f"  a : {a_opt:.5f}")
    print(f"  b : {b_opt:.4f}")
    print(f"  L :   {L_opt:.4f}")
    print(f"  R2: {r2_2:.4f}")
else:
    print("the second part failed:")
print("=" * 50)

# plotting
plt.figure(figsize=(10, 6))
plt.scatter(h_valid, Q_valid, color='gray', alpha=0.3, label='Original Data', s=10)

# plotting the first part
x_line1 = np.linspace(h1.min(), h1.max(), 100)
y_line1 = a1 * ((x_line1 - b1_seg1) ** c1)
plt.plot(x_line1, y_line1, 'r-', linewidth=2, label=f'Seg 1: Power (R2={r2_1:.3f})')

# plotting the second part
if fit_success:
    x_line3 = np.linspace(h3.min(), h3.max(), 100)
    y_line3 = sigmoid(x_line3, L_opt_3, a_opt_3, b_opt_3)
    plt.plot(x_line3, y_line3, 'b-', linewidth=2, label=f'Seg 2: Sigmoid (R2={r2_3:.3f})')
    
    x_line2 = np.linspace(h2.min(), h2.max(), 100)
    y_line2 = sigmoid(x_line2, L_opt, a_opt, b_opt)
    plt.plot(x_line2, y_line2, 'g-', linewidth=2, label=f'Seg 3: Sigmoid (R2={r2_2:.3f})')


plt.xlabel('h (ddho_ref)')
plt.ylabel('Q (diso_ref)')
plt.title('Final Fit: Power Law & Sigmoid')
plt.legend()
plt.grid(True)
plt.show()
